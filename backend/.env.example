# ──────────────────────────────────────────────
# ONGC IntelliAssist — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# REQUIRED — JWT signing secret (generate a random 64-char hex string)
SECRET_KEY=your-secret-key-here

# OPTIONAL — Bootstrap admin account created on first startup
BOOTSTRAP_ADMIN_EMAIL=admin@ongc.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# OPTIONAL — CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OPTIONAL — Ollama LLM configuration
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# OPTIONAL — Database URL (default: SQLite in project root)
# DATABASE_URL=sqlite:///./ongc_intelliassist.db

# OPTIONAL — Current-information search API (SerpAPI)
# When configured, freshness-sensitive questions (e.g. "Who is the current

# REQUIRED for fallback & general queries — Groq LLM configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
